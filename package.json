{
  "name": "dorego",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local vocal exercise studio with synchronized practice, MIDI, and video export.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "format": "prettier --write .",
    "setup:browser": "playwright install chromium",
    "test:tempo": "tsx tests/tempo.e2e.ts",
    "test:glides": "tsx tests/glides.e2e.ts",
    "test:audio": "tsx tests/audio-playback.e2e.ts",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages",
    "test:pages": "tsx tests/pages.e2e.ts",
    "export": "tsx scripts/export.ts"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "express": "^5.1.0",
    "lucide": "^0.468.0",
    "playwright": "^1.56.0",
    "tone": "^15.1.22",
    "tsx": "^4.20.6",
    "vite": "^7.1.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
